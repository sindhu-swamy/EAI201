import heapq
import math

# ---------- Heuristics ----------
def manhattan(a, b):
    return abs(a[0] - b[0]) + abs(a[1] - b[1])

def euclidean(a, b):
    return math.sqrt((a[0] - b[0])**2 + (a[1] - b[1])**2)

def diagonal(a, b):
    return max(abs(a[0] - b[0]), abs(a[1] - b[1]))

# ---------- Pathfinding Algorithms ----------
def greedy_best_first(grid, start, goal, heuristic):
    frontier = []
    heapq.heappush(frontier, (0, start))
    came_from = {start: None}
    explored = 0

    while frontier:
        _, current = heapq.heappop(frontier)
        explored += 1
        if current == goal:
            break

        for dx, dy in [(1,0),(-1,0),(0,1),(0,-1)]:
            nx, ny = current[0]+dx, current[1]+dy
            if 0 <= nx < len(grid) and 0 <= ny < len(grid[0]) and grid[nx][ny] != '1':
                next_node = (nx, ny)
                if next_node not in came_from:
                    priority = heuristic(next_node, goal)
                    heapq.heappush(frontier, (priority, next_node))
                    came_from[next_node] = current
    return reconstruct_path(came_from, start, goal), explored

def a_star(grid, start, goal, heuristic):
    frontier = []
    heapq.heappush(frontier, (0, start))
    came_from = {start: None}
    cost_so_far = {start: 0}
    explored = 0

    while frontier:
        _, current = heapq.heappop(frontier)
        explored += 1
        if current == goal:
            break

        for dx, dy in [(1,0),(-1,0),(0,1),(0,-1)]:
            nx, ny = current[0]+dx, current[1]+dy
            if 0 <= nx < len(grid) and 0 <= ny < len(grid[0]) and grid[nx][ny] != '1':
                next_node = (nx, ny)
                new_cost = cost_so_far[current] + 1
                if next_node not in cost_so_far or new_cost < cost_so_far[next_node]:
                    cost_so_far[next_node] = new_cost
                    priority = new_cost + heuristic(next_node, goal)
                    heapq.heappush(frontier, (priority, next_node))
                    came_from[next_node] = current
    return reconstruct_path(came_from, start, goal), explored

# ---------- Helper ----------
def reconstruct_path(came_from, start, goal):
    if goal not in came_from:
        return []
    path = []
    current = goal
    while current != start:
        path.append(current)
        current = came_from[current]
    path.append(start)
    path.reverse()
    return path

# ---------- Example Run ----------
if __name__ == "__main__":
    grid = [
        list("S0010"),
        list("1101G"),
        list("00010"),
        list("11011"),
        list("00000"),
    ]

    # Locate start and goal
    start = goal = None
    for i in range(len(grid)):
        for j in range(len(grid[0])):
            if grid[i][j] == "S":
                start = (i, j)
            elif grid[i][j] == "G":
                goal = (i, j)

    # Run Greedy Best-First
    path_gbfs, explored_gbfs = greedy_best_first(grid, start, goal, manhattan)
    print("Greedy Best-First Search:")
    print(" Path:", path_gbfs)
    print(" Nodes explored:", explored_gbfs, "\n")

    # Run A*
    path_astar, explored_astar = a_star(grid, start, goal, manhattan)
    print("A* Search:")
    print(" Path:", path_astar)
    print(" Nodes explored:", explored_astar)
